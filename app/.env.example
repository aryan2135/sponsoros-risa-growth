# Server-side only. Never prefix these with NEXT_PUBLIC_ (that would ship them to the browser).
# Supabase: use the IPv4 *pooler* URI (Vercel cannot reach the IPv6-only direct host). URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Live LLM analyst: set ONE of these (otherwise the deterministic analyst runs)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
ANTHROPIC_API_KEY=
# Shared demo access gate (required on Render; the app returns 503 without it there)
APP_PASSWORD=
# Reset endpoint is DISABLED unless this is exactly "true" (fail closed). Keep it unset/false in production.
ALLOW_RESET=
# Pin the AI provider: gemini | anthropic | local (default: auto)
AI_PROVIDER=
# Optional overrides: DATABASE_SSL=require|disable (default: require for non-localhost hosts)
# ALLOW_PGLITE_IN_PRODUCTION=true  # only for a local demo; production must use DATABASE_URL
